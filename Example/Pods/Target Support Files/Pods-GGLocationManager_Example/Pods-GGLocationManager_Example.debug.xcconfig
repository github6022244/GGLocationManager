CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/GGLocationManager" "${PODS_CONFIGURATION_BUILD_DIR}/GGPermission" "${PODS_CONFIGURATION_BUILD_DIR}/GGWindowManager"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/GGLocationManager/GGLocationManager.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/GGPermission/GGPermission.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/GGWindowManager/GGWindowManager.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) '@executable_path/Frameworks' '@loader_path/Frameworks'
OTHER_LDFLAGS = $(inherited) -framework "CoreLocation" -framework "Foundation" -framework "GGLocationManager" -framework "GGPermission" -framework "GGWindowManager" -framework "UIKit"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/GGLocationManager" "-F${PODS_CONFIGURATION_BUILD_DIR}/GGPermission" "-F${PODS_CONFIGURATION_BUILD_DIR}/GGWindowManager"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
